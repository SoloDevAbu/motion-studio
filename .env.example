# -----------------------------------------------------------------------------
# MotionCraft Studio — Environment Variables
# -----------------------------------------------------------------------------

# Google Gemini API Key (obtain free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Serverless PostgreSQL Connection String (obtain from https://neon.tech/)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication (optional in local dev, obtain from https://clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
